<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/richa_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="RICHA"
                android:textColor="@color/richa_text"
                android:textSize="27sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/statusText"
                android:text="Offline • Ready"
                android:textColor="@color/richa_muted"
                android:textSize="13sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:id="@+id/micState"
            android:text="MIC OFF"
            android:textColor="@color/richa_muted"
            android:textSize="11sp"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <View
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:background="@drawable/orb"
            android:alpha="0.92"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center">

            <TextView
                android:text="R"
                android:textColor="#FFFFFF"
                android:textSize="58sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/orbLabel"
                android:text="Tap to talk"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/memoryStatus"
        android:text="Local memory • On-device only"
        android:textColor="@color/richa_muted"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingTop="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/responseText"
        android:text="Hi. I'm Richa. I work offline on your phone."
        android:textColor="@color/richa_text"
        android:textSize="17sp"
        android:gravity="center"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/talkButton"
            android:text="TALK"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/wakeButton"
            android:text="ENABLE HEY RICHA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/overlayButton"
        android:text="ENABLE FLOATING BUBBLE"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"/>
</LinearLayout>
