<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/richa_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="RICHA" android:textColor="@color/richa_text" android:textSize="28sp" android:textStyle="bold" android:letterSpacing="0.12"/>
                <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="OFFLINE CORE" android:textColor="@color/richa_cyan" android:textSize="11sp"/>
            </LinearLayout>
            <TextView android:id="@+id/micState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="○ IDLE" android:textColor="@color/richa_muted" android:textSize="11sp" android:padding="10dp" android:background="@drawable/action_bg"/>
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="270dp" android:layout_marginTop="8dp" android:gravity="center">
            <View android:layout_width="220dp" android:layout_height="220dp" android:layout_gravity="center" android:background="@drawable/anime_core"/>
            <ImageView android:layout_width="165dp" android:layout_height="210dp" android:layout_gravity="center"
                android:src="@drawable/anime_girl" android:contentDescription="Richa"/>
            <TextView android:id="@+id/orbLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal" android:text="READY" android:textColor="@color/richa_text"
                android:textSize="10sp" android:textStyle="bold" android:padding="9dp" android:background="@drawable/action_bg"/>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/panel_bg" android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Richa"
                android:textColor="@color/richa_cyan" android:textSize="11sp" android:textStyle="bold"/>
            <TextView android:id="@+id/responseText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="I'm Richa." android:textColor="@color/richa_text" android:textSize="16sp" android:paddingTop="7dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/talkButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                android:text="TALK" android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
            <Button android:id="@+id/wakeButton" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="HEY RICHA" android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/aiButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
                android:text="ONLINE AI" android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
            <Button android:id="@+id/overlayButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="BUBBLE" android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:text="Offline wake word • local commands • optional Gemini brain"
            android:textColor="@color/richa_muted" android:textSize="10sp" android:paddingTop="14dp" android:paddingBottom="8dp"/>
    </LinearLayout>
</ScrollView>