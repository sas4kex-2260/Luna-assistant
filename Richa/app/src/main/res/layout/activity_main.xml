<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/richa_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RICHA"
                android:textColor="@color/richa_text"
                android:textSize="27sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE"
                android:textColor="@color/richa_lime"
                android:textSize="10sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="@drawable/action_bg"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/companionPanel"
            android:layout_width="match_parent"
            android:layout_height="315dp"
            android:layout_marginTop="8dp"
            android:gravity="center">

            <View
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:background="@drawable/anime_core"/>

            <FrameLayout
                android:id="@+id/companionHost"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_gravity="center"/>

            <ImageView
                android:id="@+id/companionPlaceholder"
                android:layout_width="175dp"
                android:layout_height="225dp"
                android:layout_gravity="center"
                android:src="@drawable/anime_girl"
                android:contentDescription="Richa companion"/>

            <TextView
                android:id="@+id/orbLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:text="READY"
                android:textColor="@color/richa_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:padding="9dp"
                android:background="@drawable/action_bg"/>

            <Button
                android:id="@+id/importCompanionButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:text="IMPORT GLB"
                android:textSize="10sp"
                android:textColor="@color/richa_text"
                android:background="@drawable/action_bg"/>

            <TextView
                android:id="@+id/micState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:text="○ IDLE"
                android:textColor="@color/richa_muted"
                android:textSize="10sp"
                android:padding="8dp"
                android:background="@drawable/action_bg"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/talkButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="TALK"
                android:textColor="@color/richa_bg"
                android:background="@drawable/lime_button"/>

            <Button
                android:id="@+id/wakeButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="HEY RICHA"
                android:textColor="@color/richa_text"
                android:background="@drawable/action_bg"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/panel_bg"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Richa"
                android:textColor="@color/richa_lime"
                android:textStyle="bold"
                android:textSize="11sp"/>

            <TextView
                android:id="@+id/responseText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Hey. I'm Richa."
                android:textColor="@color/richa_text"
                android:textSize="14sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chatPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp">

            <ScrollView
                android:id="@+id/chatScroll"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:background="@drawable/panel_bg"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/chatList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/chatInput"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="Message Richa..."
                    android:singleLine="true"
                    android:textColor="@color/richa_text"
                    android:textColorHint="@color/richa_muted"
                    android:background="@drawable/action_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"/>

                <Button
                    android:id="@+id/sendButton"
                    android:layout_width="72dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="7dp"
                    android:text="SEND"
                    android:textColor="@color/richa_bg"
                    android:background="@drawable/lime_button"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="14dp"
            android:background="@drawable/panel_bg">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TOOLS" android:textColor="@color/richa_lime" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Web Search • Files • Camera/Vision • Android actions\n\nThe tool boundary is being built incrementally. Richa will never claim a tool ran when it did not."
                android:textColor="@color/richa_text" android:textSize="14sp"/>
            <Button android:id="@+id/aiButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="12dp" android:text="CONFIGURE ONLINE AI"
                android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
            <Button android:id="@+id/overlayButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="7dp" android:text="FLOATING BUBBLE"
                android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/historyPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="14dp"
            android:background="@drawable/panel_bg">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CONVERSATION HISTORY" android:textColor="@color/richa_lime" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your current conversation is stored locally on this device."
                android:textColor="@color/richa_text" android:textSize="14sp"/>
            <Button android:id="@+id/newChatButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="12dp" android:text="NEW CHAT"
                android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
            <Button android:id="@+id/clearHistoryButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="7dp" android:text="CLEAR LOCAL HISTORY"
                android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="14dp"
            android:background="@drawable/panel_bg">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Richa SETTINGS" android:textColor="@color/richa_lime" android:textStyle="bold" android:textSize="12sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Online AI key • Voice • Companion • Memory • Privacy\n\nMore settings will be added as separate modules so daily upgrades don't destabilize existing features."
                android:textColor="@color/richa_text" android:textSize="14sp"/>
            <Button android:id="@+id/settingsAiButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="12dp" android:text="ONLINE AI KEY"
                android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
            <Button android:id="@+id/installVoiceButton" android:layout_width="match_parent" android:layout_height="46dp"
                android:layout_marginTop="7dp" android:text="INSTALL OFFLINE NEURAL VOICE"
                android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button android:id="@+id/navChat" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1"
                android:text="CHAT" android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
            <Button android:id="@+id/navCompanion" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1"
                android:text="COMPANION" android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
            <Button android:id="@+id/navTools" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1"
                android:text="TOOLS" android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button android:id="@+id/navHistory" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1"
                android:text="HISTORY" android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
            <Button android:id="@+id/navSettings" android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1"
                android:text="SETTINGS" android:textColor="@color/richa_text" android:background="@drawable/action_bg"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Richa • modular build • web search + companion renderer next"
            android:textColor="@color/richa_muted"
            android:textSize="9sp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"/>
    </LinearLayout>
</ScrollView>
